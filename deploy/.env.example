# 部署环境变量（复制为 deploy/.env 后按需修改）
# 这些值会被 deploy/install.sh 读入，写入 systemd 服务与 Caddy 配置

# 服务监听端口（默认 8787，Caddy 会反向代理到这个端口）
PORT=8787

# 域名：填了就启用 Caddy 自动 HTTPS（需要域名已解析到本机公网 IP）
# 不填则直接用 http://服务器IP:PORT 访问（无 HTTPS）
DOMAIN=

# 数据目录（数据库 + 上传文件）；留空默认 <项目>/server/data
# DATA_DIR=

# 云端容量配额（MB / 账号）
QUOTA_MB=200

# 管理员用户名（逗号分隔）；部署后也可以用 scripts/grant-admin.mjs 追加
ADMINS=
