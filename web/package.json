{
  "name": "@banyue/web",
  "version": "2.0.0-alpha.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "vue-tsc --noEmit && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "vue-tsc --noEmit && vitest run && vite build && node scripts/postbuild.mjs",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@vueuse/core": "^13.0.0",
    "dexie": "^4.4.6",
    "markdown-it": "^14.1.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.0.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.13"
  }
}
